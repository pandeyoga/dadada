+#!/usr/bin/env python3
+"""INV-PATH-01 (usulan) — PENGAMAN TAK SERAGAM ANTAR-JALUR.
+
+Kelas cacat yang dideteksi: satu entitas ditulis oleh BEBERAPA jalur kode, tetapi
+pengamannya hanya dipasang di sebagian jalur. Akibatnya aturan bisnis (gerbang
+lifecycle, eksklusivitas, lini produk, kontrak HPP) bisa dilewati lewat pintu lain
+tanpa siapa pun menyadarinya.
+
+Ditemukan 2026-09-06 pada `products` (5 jalur) dan `purchase_orders` (4 jalur).
+
+Pakai:  python3 scripts/audit_jalur_paralel.py
+Read-only. Tidak menyentuh DB.
+"""
+from __future__ import annotations
+import re, sys, pathlib, collections
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+BE = ROOT / "backend"
+
+# Entitas inti + pengaman yang SEHARUSNYA seragam di semua jalur tulisnya.
+MATRIKS = {
+    "products": {
+        "pengaman": {
+            "lifecycle diset (gerbang jual)": r"\[.lifecycle.\]\s*=|.lifecycle.\s*:|default_new_lifecycle",
+            "eksklusivitas (pexcl)":          r'pexcl\.|product_exclusivity',
+            "lini produk (line_scope)":       r'line_scope\.normalize_product|assert_can_order',
+            "validasi domain":                r'validate_product|stamp_domain_defaults',
+            "HPP tidak diisi manual":         r'harga_pokok["\']?\]?\s*[:=]\s*0',
+        },
+    },
+    "purchase_orders": {
+        "pengaman": {
+            "gerbang produk sah (rnd_gate)":  r'rnd_gate|assert_orderable',
+            "scope badan usaha":              r'entity_id',
+        },
+    },
+}
+
+
+def jalur_tulis(coll: str) -> list[str]:
+    out = []
+    for p in sorted(list(BE.glob("routers/*.py")) + list(BE.glob("services/*.py"))):
+        if re.search(rf"db\.{coll}\.insert_one", p.read_text(errors="ignore")):
+            out.append(str(p.relative_to(BE)))
+    return out
+
+
+def main() -> int:
+    pelanggaran = 0
+    for coll, spec in MATRIKS.items():
+        paths = jalur_tulis(coll)
+        print("=" * 96)
+        print(f"  {coll.upper()} — {len(paths)} jalur tulis")
+        print("=" * 96)
+        if len(paths) < 2:
+            print("  (satu jalur — tidak ada risiko ketidakseragaman)\n")
+            continue
+        lebar = max(24, min(22, 22))
